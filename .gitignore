/target

# spike reference artifacts (large, not committed)
/spike/

# wasm2rs-generated native guest crate + dispatch glue (~122MB, regenerated by
# scripts/gen-native-guest.sh; never committed) — EXCEPT the guest crate's tiny
# Cargo.toml. Cargo needs that manifest to resolve the optional `guest` path-dep
# even when the `native` feature is off, so a fresh checkout / default build
# works; the generated sources beside it stay ignored.
/native/*
!/native/guest
/native/guest/*
!/native/guest/Cargo.toml

# tooling caches
/.workspace_cache/
