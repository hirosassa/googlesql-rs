/target

# spike reference artifacts (large, not committed)
/spike/

# wasm2rs-generated native guest crate + dispatch glue (~122MB, regenerated by
# scripts/gen-native-guest.sh; never committed) — EXCEPT the guest crate's tiny
# Cargo.toml. Cargo needs that manifest to resolve the optional `guest` path-dep
# even when the `native` feature is off, so a fresh checkout / default build
# works; the generated sources beside it stay ignored.
/native/*
!/native/guest
/native/guest/*
!/native/guest/Cargo.toml
# The hand-written C-ABI cdylib wrapper (`native-ffi` feature) IS committed
# (unlike the generated `guest` beside it): the release workflow builds the
# prebuilt cdylib from these sources. Only its build output and the generated
# `../dispatch.rs` it include!s stay ignored.
!/native/guest-ffi
/native/guest-ffi/*
!/native/guest-ffi/Cargo.toml
!/native/guest-ffi/lib.rs
!/native/guest-ffi/build.rs

# The prebuilt guest tarball scripts/pack-native-guest.sh emits (published to a
# Release, never committed).
/native-guest.tar.gz

# tooling caches
/.workspace_cache/
